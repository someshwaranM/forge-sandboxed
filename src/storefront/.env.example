# Copy this file to src/storefront/.env.local; Next.js does not read the root .env.
# Agent ingest for replay batches. Set blank to use local files and /replay/<sessionId>.
NEXT_PUBLIC_REPLAY_ENDPOINT=http://localhost:8100/ingest/replay

# Elastic APM server URL for the RUM browser agent. Leave blank to disable RUM.
NEXT_PUBLIC_ELASTIC_APM_SERVER_URL=

# Server-side ingest URL for API call events. Set blank for a standalone storefront.
INGEST_URL=http://localhost:8100
