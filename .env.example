# Copy this file to .env and fill in values locally. Never commit .env.

# Elastic Cloud deployment
ELASTIC_CLOUD_ENDPOINT=
ELASTIC_API_KEY=
KIBANA_URL=
KIBANA_CASE_OWNER=observability

# AWS, for Bedrock and S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_VISION_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSIONS=1024
S3_CLIPS_BUCKET=

# Sarvam
SARVAM_API_KEY=

# Storefront
NEXT_PUBLIC_REPLAY_ENDPOINT=http://localhost:8100/ingest/replay
NEXT_PUBLIC_ELASTIC_APM_SERVER_URL=
INGEST_URL=http://localhost:8100
STOREFRONT_URL=http://localhost:3000
